  "narrative": {
    "northStar": "The Shared Monthly Folio",
    "overview": "Warm parchment and ivory surfaces support ink-blue actions. Charter-led headings establish sections; system sans-serif labels and tabular amounts keep the ledger easy to scan. Fine rules and restrained surfaces give this working interface its character.\n\nCopy stays short, English, and task-oriented. The folio metaphor guides materials and hierarchy without adding slogans, decorative prose, photography, or illustrations.",
    "keyCharacteristics": [
      "Warm neutral surfaces with ink-blue actions.",
      "Serif headings and sans-serif tabular amounts.",
      "Ruled transaction rows with explicit status.",
      "Comfortable mobile controls and compact desktop navigation."
    ],
    "rules": [
      {
        "name": "The Ink Rule",
        "body": "Use ink-blue for actions, selection, and the primary monthly figure while keeping neutral surfaces dominant.",
        "section": "colors"
      },
      {
        "name": "The Numeric Rule",
        "body": "All amounts use sans-serif tabular lining numerals; serif type is reserved for headings and the wordmark.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Routine ledger content stays flat; shadows distinguish temporary overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep interface copy in English and state the task directly.",
      "Do use the existing parchment, ivory, and ink-blue palette.",
      "Do use sans-serif tabular lining numerals for amounts.",
      "Do preserve keyboard focus, explicit state labels, and safe-area clearance."
    ],
    "donts": [
      "Don't add slogans, cute empty states, or redundant descriptions.",
      "Don't use serif type for financial amounts.",
      "Don't communicate financial or review states through color alone.",
      "Don't add routine card shadows or decorative imagery.\r"
    ]
  }
}
