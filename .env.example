# scripts/init-local.mjs generates random local secrets. Do not commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=8765
APP_ORIGIN=http://127.0.0.1:8765
SESSION_SECRET=replace-with-at-least-48-random-characters
# Separate key: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BANK_TOKEN_KEY=replace-with-a-base64url-encoded-32-byte-key
POSTGRES_PASSWORD=replace-with-a-random-local-database-password
DATABASE_URL=postgresql://ledger:replace-password@127.0.0.1:55441/ledger_nest
# Destructive integration tests ONLY use this dedicated database, ending in _test.
TEST_DATABASE_URL=postgresql://ledger:replace-password@127.0.0.1:55441/ledger_nest_test
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_WEBHOOK_URL=
PLAID_REDIRECT_URI=
# Railway: NODE_ENV=production, HOST=0.0.0.0, APP_ORIGIN=https://<web-domain>.
# Web and worker share DATABASE_URL, SESSION_SECRET and BANK_TOKEN_KEY.
